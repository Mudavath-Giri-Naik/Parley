# ---------------------------------------------------------------------------
# Parley configuration
#
# This file IS the customization system. Every merchant-specific value in Parley
# comes from here; nothing is hardcoded in the source. Copy to `.env.local` for
# local development, or paste these into your host's environment settings.
# ---------------------------------------------------------------------------

# --- Required: who you are -------------------------------------------------

# Shown to customers and to any agent that connects.
MERCHANT_NAME="Your Store"

# --- Required: your own storefront APIs ------------------------------------
#
# These are YOUR endpoints. Parley never writes to a database you did not
# configure, and it never bypasses your own order pipeline.
#
# Any of these may contain an `{id}` placeholder, e.g.
#   MERCHANT_STOCK_API=https://yourstore.example.com/api/products/{id}
# Without a placeholder, the id is appended as a path segment.

# GET, returns a list of products. Parley sends ?q= (also ?query=, ?search=)
# plus ?size=, ?color=, ?max_price= when the customer gives those.
MERCHANT_SEARCH_API=https://yourstore.example.com/api/products

# GET one product, used for details and for live stock checks.
MERCHANT_STOCK_API=https://yourstore.example.com/api/products

# POST, creates an order and reserves stock. Your backend owns the stock lock;
# Parley only calls it. Return a non-2xx or an out-of-stock message to refuse.
MERCHANT_ORDER_API=https://yourstore.example.com/api/orders

# Optional. GET one order's status. Defaults to MERCHANT_ORDER_API.
# MERCHANT_ORDER_STATUS_API=https://yourstore.example.com/api/orders/{id}

# Optional. Sent on every request to your APIs if your endpoints need auth.
# MERCHANT_API_KEY=
# MERCHANT_API_KEY_HEADER=Authorization

# --- Optional: speaking your API's language --------------------------------

# Only needed when your API's field names differ from Parley's. Keys are
# Parley's names; values are yours. Valid keys: id, name, price, stock,
# currency, description, image, url, size, color.
# Common aliases (title, cost, qty, quantity, inventory, ...) are detected
# automatically, so most merchants can leave this unset.
# FIELD_MAP={"name":"title","price":"cost","stock":"qty"}

# Does your API report prices in major units (1499 = 1499 rupees) or minor
# units (149900 = 1499 rupees)? Getting this wrong misprices every order by
# a factor of 100, so check one real product before you go live.
PRICE_UNIT=minor

# ISO currency code used for payments and display.
CURRENCY=INR

# Regex matching your API's out-of-stock response. The default catches the
# usual phrasings; override it if your API says something unusual. This is only
# applied to 2xx/4xx replies: a 5xx is treated as an outage, never as "sold out".
# OUT_OF_STOCK_PATTERN=out[_\s-]?of[_\s-]?stock|sold[_\s-]?out|unavailable

# Some APIs refuse an order with HTTP 200 and a flag in the body. These name the
# fields Parley inspects before it treats an order as accepted. A success field
# set to false, or an error field carrying real content, means refused - so
# nothing is charged. Empty values (error: null, errors: []) are not refusals.
# ORDER_SUCCESS_FIELDS=ok,success,succeeded,is_success,isSuccess
# ORDER_ERROR_FIELDS=error,errors,error_code,errorCode,error_message,errorMessage,failure,fault

# --- Required for payments: your own Razorpay keys -------------------------
#
# Test-mode keys start with rzp_test_. These stay in your environment; Parley
# creates payment links on your account and never sees a card number.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. Where Razorpay sends the customer after they pay.
# PAYMENT_CALLBACK_URL=https://your-parley-deployment.example.com/dashboard

# --- The limits your agent works within ------------------------------------

# Hard ceiling on any discount. Enforced in code when the order is priced, not
# by asking the agent nicely. Set to 0 to disable discounting entirely.
MAX_DISCOUNT_PERCENT=10

# How your agent should come across.
AGENT_PERSONA="Friendly, concise, never pushy"

# Default spend cap for a new mandate, in MINOR units (500000 = 5000.00).
SPEND_CAP_DEFAULT=500000

# How long a new mandate stays valid.
MANDATE_TTL_DAYS=30

# --- Required for the audit trail and mandates -----------------------------
#
# Parley's own small Postgres, separate from your product database. A free
# Supabase or Neon project is plenty. Parley creates its two tables on first
# use: audit_log and mandates.
PARLEY_DB_URL=postgresql://user:password@host:5432/database?sslmode=require

# Set to true to verify the database's TLS certificate chain. Leave unset for
# managed Postgres behind a pooler.
# PARLEY_DB_SSL_STRICT=false

# --- Optional: the conversational seller agent -----------------------------
#
# Without a provider key the MCP tools still work and a buyer agent can transact.
# With one, buyers also get a `negotiate_with_seller` tool that haggles on your
# behalf. Set whichever provider you already pay for; you do not need both.
#
# Which provider reasons for the seller agent: auto | anthropic | gemini.
# "auto" uses whichever key is set, preferring Anthropic if you set both.
# AGENT_PROVIDER=auto

# Anthropic
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5

# Google Gemini. Requires a modern key; the newer AQ... keys work natively with
# the @google/genai SDK that Parley uses.
# Note the free tier is tight: gemini-3.7-flash allows only 20 requests/day.
# gemini-3.5-flash-lite has a more generous free allowance if you are testing.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# How many times to retry a Gemini call that fails because the model is busy.
# GEMINI_MAX_ATTEMPTS=4

# --- Optional: deployment details ------------------------------------------

# Public URL of this deployment. Auto-detected on Vercel; set it if you use a
# custom domain, so the discovery document advertises the right address.
# PARLEY_PUBLIC_URL=https://your-parley-deployment.example.com

# Set to require `Authorization: Bearer <token>` on the MCP endpoint. Leave
# unset to leave the endpoint open to any agent that finds it.
# PARLEY_API_KEY=

# How long to wait on your APIs before giving up.
# MERCHANT_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Discovery Service
#
# The service that makes this catalog findable by AI shopping agents: a UCP
# profile, an ACP product feed, schema.org markup, a crawler access check, and
# an appearance log. It reads the same catalog APIs configured above — there is
# no second copy of your product data anywhere.
#
# Every value below is optional. With none of them set, the service works.
# See docs/DISCOVERY.md.
# ---------------------------------------------------------------------------

# How long a catalog read may be reused, in milliseconds. Capped at five minutes,
# because a stale price is the one failure this service must not have. Set to 0
# to read the catalog live on every request.
# DISCOVERY_CACHE_TTL_MS=60000

# Most products walked in one catalog read.
# DISCOVERY_CATALOG_LIMIT=500

# Query parameters added to the catalog listing call.
#
# Many storefronts hide sold-out products by default. To a shopping agent an absent
# product is one you do not sell, which is worse than "out of stock" — so the
# listing asks for them explicitly, sending several common spellings at once.
# Override only if your API spells it differently.
# DISCOVERY_CATALOG_PARAMS={"include_sold_out":"true","include_out_of_stock":"true","include_unavailable":"true"}

# Collapse catalog rows that share a title into one product with several variants.
# Set to false if your catalog is already one row per product.
# DISCOVERY_GROUP_VARIANTS=true

# Your storefront's public origin. Defaults to the origin of MERCHANT_SEARCH_API,
# which is right whenever your shop and its API share a domain. The crawler checker
# reads robots.txt here.
# STOREFRONT_URL=https://yourstore.example.com

# Where your own product pages live, if you have them. Used as the canonical URL in
# the feed and the JSON-LD. Without it, this service's own /p/{id} pages are used.
# DISCOVERY_PRODUCT_URL_TEMPLATE=https://yourstore.example.com/products/{id}

# ISO 3166-1 alpha-2 country code describing the ACP feed's target market.
# DISCOVERY_FEED_TARGET_COUNTRY=IN

# Which AI crawlers to check for and allow by name in this service's robots.txt.
# DISCOVERY_CRAWLERS=GPTBot,ClaudeBot,PerplexityBot,Google-Extended

# Signs cart ids so a platform cannot mint a cart at a price of its choosing.
# Falls back to PARLEY_API_KEY, then to your Razorpay secret. Every amount is
# recomputed from the catalog regardless, so an unsigned deployment is not
# mispriced, only unauthenticated.
# DISCOVERY_CART_SECRET=

# --- Optional: the appearance log -------------------------------------------
#
# Buyer-style questions asked of AI assistants, with the answers recorded verbatim.
# Labelled "observed appearance, not a guaranteed ranking" everywhere it appears,
# because that is all it is.
#
# Questions are generated from your own catalog. Override with a |-separated list.
# APPEARANCE_QUESTIONS=best cotton tee under 1500|where to buy a hoodie online in India

# Each platform is probed only when its key is set, and reported as untestable with
# a reason when it is not. No result is ever invented for a platform that could not
# be reached.
#
# Gemini: real Google Search grounding. Note that grounding is a paid-tier feature —
# a free key returns 429 and the probe records that rather than substituting an
# ungrounded answer, which would say nothing about whether you are findable.
# APPEARANCE_GEMINI_MODEL=gemini-3.7-flash

# Claude: the Anthropic Messages API's server-side web_search tool.
# APPEARANCE_ANTHROPIC_MODEL=claude-opus-5

# Perplexity: the Sonar API, which is the product's own retrieval stack.
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# ChatGPT: there is no ChatGPT API and no shopping-surface API. Setting this probes
# the OpenAI Responses API's web_search tool, which is a DIFFERENT retrieval stack.
# Every row it produces says so. Treat it as an indicator, not as ChatGPT.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1
